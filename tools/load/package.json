{
  "name": "@bululu/load",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Load tests (E8-S3): N socket.io-client bots walking in one space, and hallway media conversations against LiveKit.",
  "scripts": {
    "load": "tsx --conditions=@bululu/source src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "media": "tsx src/media.ts"
  },
  "dependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "@bululu/shared": "workspace:*",
    "livekit-server-sdk": "^2.19.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
