{
  "name": "@bululu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plaza API + realtime server (Fastify, Socket.IO, Prisma).",
  "scripts": {
    "dev": "tsx watch --conditions=@bululu/source --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@bululu/maps": "workspace:*",
    "@bululu/shared": "workspace:*",
    "@prisma/client": "~6.19.3",
    "@sentry/node": "^10.75.3",
    "fastify": "^5.12.5",
    "google-auth-library": "^10.9.1",
    "livekit-server-sdk": "^2.19.1",
    "pino": "^10.3.1",
    "prisma": "~6.19.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "@types/node": "^22.19.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
