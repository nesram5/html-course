{
  "name": "@plaza/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared contracts (zod), game constants and pure world logic used by web and server.",
  "exports": {
    ".": {
      "@plaza/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
