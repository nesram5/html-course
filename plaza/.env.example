# ─────────────────────────────────────────────────────────────────────────────
# Plaza — environment variables. Copy to `.env` (never commit it):
#   cp .env.example .env
# The server validates every variable at start-up and refuses to start, naming the
# offending variable, if something is missing or invalid (apps/server/src/platform/config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
# `pnpm infra:up` starts PostgreSQL 16 with these credentials; then run `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plaza_dev
# Integration tests use their own database (created and migrated automatically).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plaza_test

# Max HTTP requests per minute and client IP.
RATE_LIMIT_PER_MINUTE=300

# ── Web and sessions ────────────────────────────────────────────────────────
# Public origin of the web app (Vite dev server locally). Used for OAuth redirects,
# invite links and CORS.
PUBLIC_URL=http://localhost:5173
# Signs cookies and derives invite tokens. At least 32 random characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-32-or-more-random-characters

# ── Google sign-in and Google Meet (E1, E2-S7) ──────────────────────────────
# Optional locally (use AUTH_TEST_LOGIN instead); required in production.
# How to get a development OAuth client:
#   1. https://console.cloud.google.com → create project "plaza-dev".
#   2. APIs & Services → Library → enable "Google Meet REST API".
#   3. OAuth consent screen → External, "Testing" mode; add yourself and the team as test users;
#      scopes: openid, email, profile and https://www.googleapis.com/auth/meetings.space.created.
#   4. Credentials → Create credentials → OAuth client ID → "Web application" with
#      Authorized redirect URIs:
#        http://localhost:5173/api/auth/google/callback
#        http://localhost:5173/api/auth/google/meet/callback
#   5. Copy the client ID and secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test-only sign-in (POST /api/auth/test-login). CI and local only: the server refuses to
# start when this is true and NODE_ENV=production.
AUTH_TEST_LOGIN=true

# ── LiveKit: hallway audio/video (E5) ───────────────────────────────────────
# Option A — local server (no account): `pnpm infra:up:livekit` runs `livekit-server --dev`,
#   whose fixed credentials are below.
# Option B — LiveKit Cloud free plan (max. 5 connections, enough for development):
#   https://cloud.livekit.io → create a project → Settings → Keys → create a key; use the
#   project URL (wss://<project>.livekit.cloud) and the key/secret.
# Staging and beta use the self-hosted server of E5-S7 (only these three values change).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Error reporting (optional) ──────────────────────────────────────────────
# https://sentry.io → create two projects (Node.js and React) → Settings → Client Keys (DSN).
# Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Web app (read by Vite at build time; only VITE_* variables reach the browser).
VITE_SENTRY_DSN=
