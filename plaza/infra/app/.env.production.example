# ─────────────────────────────────────────────────────────────────────────────
# Plaza — production / staging environment of infra/app/docker-compose.yml (E8-S5).
#   cp .env.production.example .env && chmod 600 .env
# Never commit .env. Keep a copy of every secret in the team's secret manager.
# The server validates every variable at start-up and refuses to start, naming the offending
# variable (apps/server/src/platform/config.ts). Staging and beta use DIFFERENT values for
# every secret below (SESSION_SECRET, Google client, LiveKit keys, HEALTH_TOKEN).
# ─────────────────────────────────────────────────────────────────────────────

# ── Images (set by the deploy workflow; pin a released version) ─────────────
PLAZA_SERVER_IMAGE=ghcr.io/<owner>/plaza-server:v0.1.0
PLAZA_WEB_IMAGE=ghcr.io/<owner>/plaza-web:v0.1.0

# ── Caddy (web) ─────────────────────────────────────────────────────────────
# The public domain: Caddy gets its Let's Encrypt certificate automatically (ports 80/443 open).
SITE_ADDRESS=plaza.example.com
# Origins the browser may connect to besides the app itself: LiveKit and the Sentry ingest.
CSP_CONNECT_SRC=wss://livekit.example.com https://livekit.example.com https://o000000.ingest.de.sentry.io
PLAZA_HTTP_PORT=80
PLAZA_HTTPS_PORT=443

# ── Server ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PUBLIC_URL=https://plaza.example.com
# 32+ random characters: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates every invite link (docs/runbook.md, "Rotar claves").
SESSION_SECRET=
# Behind the Caddy of this compose file: exactly one trusted proxy hop (set in the compose file).
# TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=300
REALTIME_CONNECTIONS_PER_MINUTE=120
# Unlocks the detailed GET /api/health (X-Health-Token header). 16+ random characters.
HEALTH_TOKEN=
# NEVER true in production: the server refuses to start with it.
AUTH_TEST_LOGIN=false

# ── Database ────────────────────────────────────────────────────────────────
# Bundled PostgreSQL + daily pg_dump (the "db" profile); leave empty with a managed database.
COMPOSE_PROFILES=db
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://plaza:<POSTGRES_PASSWORD>@postgres:5432/plaza
# Managed PostgreSQL instead: DATABASE_URL=postgresql://user:password@host:5432/plaza?sslmode=require
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# ── Google sign-in and Meet (production Google Cloud project) ──────────────
# Redirect URIs: https://plaza.example.com/api/auth/google/callback
#                https://plaza.example.com/api/auth/google/meet/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LiveKit (media VM of infra/livekit, keys different from staging) ────────
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Sentry (optional; the web DSN is baked into the web image at build time) ─
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
