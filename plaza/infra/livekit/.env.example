# Media VM configuration (copy to .env; .env is never committed).
# Generate the key pair with: docker run --rm livekit/livekit-server:v1.9.12 generate-keys
LIVEKIT_API_KEY=
# At least 32 characters.
LIVEKIT_API_SECRET=
# Public names of the VM (A records pointing to its IP).
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com
# Public https origin of the app server of this environment: LiveKit sends its signed webhooks to
# <APP_URL>/api/media/livekit-webhook (E6-S3).
APP_URL=https://plaza.example.com
# Optional: Caddy image with the layer4 module, pinned by digest after the first deploy,
# e.g. livekit/caddyl4@sha256:<digest>
# CADDY_L4_IMAGE=
